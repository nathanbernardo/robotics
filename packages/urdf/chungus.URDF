<robot name="chungus">
  <link name="base_link" />
  <link name="link2" />
  <link name="link3" />
  <link name="link4" />
  <link name="link5" />
  <link name="link6" />
  <link name="link7" />

  <!-- TODO: redo all the origin lengths -->
  <!-- note: the convention is x is pointed to us, y is pointed to the right, z is pointed up -->
  <!-- note: base link is the ground. link 2 is the height from the ground to the shoulder motor -->
  <!-- note: everything should be in meters -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link2"/>
    <origin xyz="0 0.0 0" rpy="0 0 0"/>
    <axis
      xyz="0 0 1" />
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0.0 0.1397" rpy="0 0 0"/>
    <axis
      xyz="1 0 0" />
    <limit lower="0" upper="0.785"/>
  </joint>
  
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.0 -0.236982 0.21463" rpy="0 0 0"/>
    <axis
      xyz="1 0 0" />
    <limit lower="-1.57" upper="1.57"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.0 -0.10795 -0.05334" rpy="0 0 0"/>
    <axis
      xyz="0 0 -1" />
  </joint>

  <joint name="joint5" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 -0.1397 -0.1524" rpy="0 0 0"/>
    <axis
      xyz="0 -1 0" />
  </joint>

  <joint name="joint6" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin xyz="0 -0.1905 0.0" rpy="0 0 0"/>
    <axis
      xyz="-1 0 0" />
  </joint>

</robot>